# Environment variables for JingleGen AI
# GEMINI_API_KEY: Optional. If provided, Gemini generates advanced contextual lyrics and evaluation.
# If omitted or invalid, JingleGen AI automatically runs with its built-in algorithmic engine and offline audio synthesizer.
GEMINI_API_KEY=""

# Application Port (Default: 3000 for AI Studio environment)
PORT=3000
HOST="0.0.0.0"
